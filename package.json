{
  "name": "subtext",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "subtext": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "os": [
    "win32",
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "build:linux": "bun build src/main.ts --compile --target=bun-linux-x64 --outfile release/watchless",
    "build:windows": "bun build src/main.ts --compile --target=bun-windows-x64 --outfile release/watchless.exe",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "extract-zip": "^2.0.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
